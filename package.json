{
  "name": "concurrent-quiz",
  "version": "1.0.0",
  "description": "A real-time competitive math quiz where multiple users race to answer dynamically generated problems",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file=.env server/index.js",
    "dev": "node --watch --env-file=.env server/index.js"
  },
  "keywords": [
    "quiz",
    "math",
    "realtime",
    "websocket"
  ],
  "license": "MIT",
  "dependencies": {
    "@upstash/redis": "^1.37.0",
    "express": "^4.21.0",
    "socket.io": "^4.8.0"
  }
}
